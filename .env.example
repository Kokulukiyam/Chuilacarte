# Toutes les variables sont FACULTATIVES. Sans clé, la fonction correspondante est
# désactivée proprement (message clair) ou remplacée par un service public sans clé.

# Adresse de contact (réelle) ajoutée au User-Agent envoyé à Nominatim, Overpass et Valhalla,
# comme le demandent leurs règles d'usage. Recommandé.
CHUILACARTE_CONTACT=

# Serveurs Overpass, essayés dans l'ordre (séparés par des virgules)
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Isochrones : serveur Valhalla public (sans clé) — valeur par défaut
# VALHALLA_URL=https://valhalla1.openstreetmap.de

# OpenRouteService (isochrones, prioritaire sur Valhalla si renseigné)
# Clé gratuite : https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Esri World Imagery (fond satellite haute résolution). Compte gratuit ArcGIS Location Platform :
# https://location.arcgis.com/sign-up/  → créer une clé d'API avec le droit « Basemaps ».
ARCGIS_API_KEY=

# Mosaïque EOxCloudless (Sentinel-2 sans nuages), licence NON COMMERCIALE (CC BY-NC-SA 4.0).
# À n'activer que pour un usage strictement personnel non commercial.
ENABLE_NONCOMMERCIAL_SOURCES=false
